// Minimal Waybar configuration for Hyprland
{
  "layer": "top",
  "position": "top",
  "height": 20,
  "spacing": 8,
  "margin-top": 5,
  // Negative bottom margin reduces the exclusive zone so tiled windows sit closer to the bar
  "margin-bottom": -15,
  "margin-left": 20,
  "margin-right": 20,
  "reload_style_on_change": true,

  "modules-left": [
    "hyprland/workspaces",
    "group/hardware"
  ],
  "modules-center": [
    "custom/media",
    "clock",
    "hyprland/window"
  ],
  "modules-right": [
    "bluetooth",
    "pulseaudio",
    "group/utilities",
    "tray",
    "custom/notification",
    "group/power"
  ],

  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "custom/cpu",
      "custom/gpu",
      "custom/net-speed",
      "custom/storage"
    ]
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu.py",
    "return-type": "json",
    "interval": 2,
    "on-click": "kitty -e btop"
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.py",
    "return-type": "json",
    "interval": 2,
    "on-click": "kitty -e nvtop"
  },

  "custom/net-speed": {
    "exec": "~/.config/waybar/scripts/net-speed.py",
    "return-type": "json",
    "interval": 2,
    "on-click": "kitty -e nmtui"
  },

  "custom/storage": {
    "exec": "~/.config/waybar/scripts/storage.py",
    "return-type": "json",
    "interval": 2,
    "on-click": "kitty -e ncdu ~"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true
  },

  "custom/media": {
    "exec": "~/.config/waybar/scripts/media.py",
    "return-type": "json",
    "interval": 2,
    // Right-aligned inside its fixed 540px slot so text expands leftward from the clock
    "align": 1,
    "on-click": "playerctl play-pause"
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "format-alt": "{:%a %d %b  %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#bb9af7'><b>{}</b></span>",
        "days": "<span color='#c0caf5'>{}</span>",
        "weeks": "<span color='#7dcfff'><b>W{}</b></span>",
        "weekdays": "<span color='#7aa2f7'><b>{}</b></span>",
        "today": "<span color='#f7768e'><b><u>{}</u></b></span>"
      }
    }
  },

  "hyprland/window": {
    // Prefix with {class}:: so rewrite rules can match apps/games regardless of title
    "format": "{class}::{title}",
    "max-length": 38,
    // Left-aligned inside its fixed 540px slot so text expands rightward from the clock
    "align": 0,
    "separate-outputs": true,
    "rewrite": {
      "(?:[Ss]team|steam_app_.*)::(.*)": "  $1",
      "[Ss]idra::(.*)": "󰎇  $1",
      "[Kk]itty.*::(.*)": "󰄛  $1",
      "(?:com\\.mitchellh\\.)?[Gg]hostty::(.*)": "󰊠  $1",
      "firefox::(.*) — Mozilla Firefox": "󰈹  $1",
      "firefox::(.*)": "󰈹  $1",
      "(?:google-chrome|chromium)::(.*) - (?:Google Chrome|Chromium)": "  $1",
      "(?:google-chrome|chromium)::(.*)": "  $1",
      "(?:code|Code|cursor|Cursor)::(.*) - (?:Visual Studio Code|Cursor)": "󰨞  $1",
      "(?:code|Code|cursor|Cursor)::(.*)": "󰨞  $1",
      "org\\.kde\\.dolphin::(.*) — Dolphin": "󰉋  $1",
      "org\\.kde\\.dolphin::(.*)": "󰉋  $1",
      "(?:[Dd]iscord|[Vv]esktop)::(.*)": "  $1",
      "[Ss]potify::(.*)": "󰓇  $1",
      "^::$": "",
      // Fallback: strip {class}:: for any unmatched app
      ".*::(.*)": "$1"
    }
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} ({device_battery_percentage}%)",
    // Uses Hyprland's Lua dispatcher (hl.dsp.exec_cmd) to toggle a floating top-right popup
    "on-click": "pkill -x blueman-manager || hyprctl -q dispatch 'hl.dsp.exec_cmd(\"[float;size 600 450;move (monitor_w-window_w-20) 65] blueman-manager\")' >/dev/null 2>&1",
    "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  muted",
    "on-click": "pkill -x pavucontrol || hyprctl dispatch 'hl.dsp.exec_cmd(\"[float;size 600 450;move (monitor_w-window_w-20) 65] pavucontrol\")'",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "tooltip": false
  },

  "group/utilities": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 250,
      "children-class": "utility-child",
      // Expand drawer items to the left of the gear icon
      "transition-left-to-right": false
    },
    "modules": [
      "custom/drawer-icon",
      "idle_inhibitor",
      "power-profiles-daemon"
    ]
  },

  "custom/drawer-icon": {
    "format": "󰒓",
    "tooltip-format": "Hover to reveal utilities"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Idle inhibitor: ON (screen stays awake)",
    "tooltip-format-deactivated": "Idle inhibitor: OFF"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}\nClick to cycle",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰌪"
    }
  },

  "tray": {
    "icon-size": 22,
    "spacing": 12
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#f7768e'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='#f7768e'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='#f7768e'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='#f7768e'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "group/power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 250,
      "children-class": "power-child",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/power",
      "custom/lock",
      "custom/suspend",
      "custom/logout",
      "custom/reboot"
    ]
  },

  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Shutdown",
    "on-click": "systemctl poweroff"
  },

  "custom/lock": {
    "format": "󰌾",
    "tooltip-format": "Lock",
    "on-click": "command -v hyprlock >/dev/null && hyprlock || loginctl lock-session"
  },

  "custom/suspend": {
    "format": "󰤄",
    "tooltip-format": "Suspend",
    "on-click": "systemctl suspend"
  },

  "custom/logout": {
    "format": "󰍃",
    "tooltip-format": "Logout",
    "on-click": "hyprctl -q dispatch 'hl.dsp.exit()'"
  },

  "custom/reboot": {
    "format": "󰜉",
    "tooltip-format": "Reboot",
    "on-click": "systemctl reboot"
  }
}
