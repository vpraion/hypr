// ============================================================================
// Waybar Configuration — Floating Islands + Drawers (Tokyo Night)
// Waybar v0.16+ | Docs: https://github.com/Alexays/Waybar/wiki/Configuration
// ============================================================================
{
  // ── Bar Layout & Positioning ──────────────────────────────────────────────
  "layer": "top",                    // Render above normal windows
  "position": "top",                 // "top", "bottom", "left", or "right"
  // Omit "height" so the bar hugs the pills tightly without extra vertical slack
  "margin-top": 8,                   // Top gap from screen edge
  "margin-bottom": 0,                // 0 so Hyprland's gaps_out alone controls the gap to windows
  "margin-left": 12,                 // Left gap from screen edge
  "margin-right": 12,                // Right gap from screen edge
  "spacing": 8,                      // Gap between separate floating islands
  "reload_style_on_change": true,    // Live-reload style.css on save

  // ── Module Placement ──────────────────────────────────────────────────────
  "modules-left": [],
  "modules-center": [
    "hyprland/workspaces",
    "hyprland/submap",               // Only appears when a Hyprland submap (e.g. resize) is active
    "hyprland/window",
    "mpris"
  ],
  "modules-right": [
    "group/hardware",
    "group/connectivity",
    "group/utilities",               // Hoverable drawer: caffeine + power profile
    "tray",
    "clock"                          // Rightmost position
  ],

  // ── Module Groups ─────────────────────────────────────────────────────────
  "group/hardware": {
    "orientation": "inherit",
    "modules": [
      "cpu",
      "memory",
      "battery"
    ]
  },

  "group/connectivity": {
    "orientation": "inherit",
    "modules": [
      "pulseaudio",
      "bluetooth",
      "network"
    ]
  },

  // Expandable drawer: shows the trigger icon, reveals tools smoothly on hover
  "group/utilities": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "utility-child",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/drawer-icon",          // Always-visible leader icon
      "idle_inhibitor",              // Caffeine toggle (prevent sleep/idle)
      "power-profiles-daemon"        // Cycle power-saver / balanced / performance
    ]
  },

  // ── Left Modules ──────────────────────────────────────────────────────────
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "sort-by-number": true,
    "format-icons": {
      "active": "󰮯",                 // Pacman-style active workspace indicator
      "urgent": "",
      "default": "󰊠"
    }
    // Uncomment to keep workspaces 1-5 always visible:
    // "persistent-workspaces": {
    //   "*": 5
    // }
  },

  "hyprland/submap": {
    "format": "󰌌  {}",
    "max-length": 18,
    "tooltip": false
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 40,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "󰈹  $1",
      "(.*) - Visual Studio Code": "󰨞  $1",
      "(.*) - kitty": "󰄛  $1",
      "(.*) - Ghostty": "󰊠  $1"
    }
  },

  "mpris": {
    // Automatically hides when no media player is active
    "format": "{player_icon}  {dynamic}",
    "format-paused": "{status_icon}  <i>{dynamic}</i>",
    "max-length": 36,
    "dynamic-order": ["title", "artist"],
    "player-icons": {
      "default": "󰎈",
      "spotify": "󰓇",
      "firefox": "󰈹",
      "chromium": ""
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  // ── Center Module ─────────────────────────────────────────────────────────
  "clock": {
    "format": "󰥔  {:%H:%M   󰃭  %a %d %b}",
    "format-alt": "󰥔  {:%H:%M:%S   󰃭  %Y-%m-%d}", // Click to toggle seconds & ISO date
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#bb9af7'><b>{}</b></span>",
        "days": "<span color='#c0caf5'>{}</span>",
        "weeks": "<span color='#7dcfff'><b>W{}</b></span>",
        "weekdays": "<span color='#7aa2f7'><b>{}</b></span>",
        "today": "<span color='#f7768e'><b><u>{}</u></b></span>"
      }
    }
  },

  // ── Right Modules: Hardware Group ─────────────────────────────────────────
  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "tooltip": true,
    "on-click": "kitty -e btop"     // Opens btop on click
  },

  "memory": {
    "interval": 5,
    "format": "  {percentage}%",
    "tooltip-format": "RAM: {used:0.1f} GiB / {total:0.1f} GiB ({percentage}%)\nSwap: {swapUsed:0.1f} GiB / {swapTotal:0.1f} GiB",
    "on-click": "kitty -e btop"
  },

  "battery": {
    "interval": 10,
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-alt": "{icon}  {time}",   // Click to toggle remaining time
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\nPower draw: {power:.1f}W"
  },

  // ── Right Modules: Connectivity & Audio Group ─────────────────────────────
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-bluetooth": "󰂯 {icon}  {volume}%",
    "format-muted": "󰝟  Muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱  {device_alias}",
    "format-connected-battery": "󰂱  {device_alias} ({device_battery_percentage}%)",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\nLeft-click: Toggle power\nRight-click: bluetoothctl",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && bluetoothctl power off || bluetoothctl power on'",
    "on-click-right": "kitty -e bluetoothctl"
  },

  "network": {
    "interval": 5,
    "format-wifi": "󰖩  {essid}",
    "format-ethernet": "󰈀  {ifname}",
    "format-disconnected": "󰖪  Offline",
    "max-length": 20,
    "tooltip-format-wifi": "SSID: {essid} ({signalStrength}%)\nIP: {ipaddr}/{cidr}\nFreq: {frequency} GHz",
    "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "kitty -e nmtui"     // Opens nmtui in kitty
  },

  // ── Right Modules: Utilities Drawer ───────────────────────────────────────
  "custom/drawer-icon": {
    "format": "󰍜",
    "tooltip-format": "Hover to reveal utilities"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",              // Caffeine ON (stay awake)
      "deactivated": "󰾪"             // Caffeine OFF (normal idle)
    },
    "tooltip-format-activated": "Idle inhibitor: ON (screen stays awake)",
    "tooltip-format-deactivated": "Idle inhibitor: OFF"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}\nClick to cycle",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰌪"
    }
  },

  // ── Right Modules: System Tray ────────────────────────────────────────────
  "tray": {
    "icon-size": 20,
    "spacing": 8
  }
}
